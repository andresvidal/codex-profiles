{
  "name": "codex-profiles",
  "displayName": "Codex Profiles",
  "description": "Switch Codex accounts without changing your VS Code development environment.",
  "version": "0.0.1",
  "publisher": "andresvidal",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexProfiles.selectProfile",
        "title": "Codex Profiles: Select Profile"
      },
      {
        "command": "codexProfiles.createProfile",
        "title": "Codex Profiles: Create Profile"
      },
      {
        "command": "codexProfiles.showActiveProfile",
        "title": "Codex Profiles: Show Active Profile"
      },
      {
        "command": "codexProfiles.launchCodexCli",
        "title": "Codex Profiles: Launch Codex CLI"
      }
    ],
    "configuration": {
      "title": "Codex Profiles",
      "properties": {
        "codexProfiles.profiles": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "description": "Custom Codex account profiles. Default uses the existing CODEX_HOME or ~/.codex. New profiles isolate account state in their own Codex home and share the Default Codex configuration unless configMode is isolated.",
          "items": {
            "type": "object",
            "required": ["id", "name", "codexHome"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "codexHome": { "type": "string" },
              "configMode": {
                "type": "string",
                "enum": ["shared", "isolated"],
                "default": "shared",
                "description": "Whether this account inherits the Default profile's Codex config.toml until customized or keeps independent Codex configuration."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "tsx --test test/**/*.test.ts",
    "ci": "npm run check && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.104.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
