{
  "name": "codex-profiles",
  "displayName": "Codex Profiles",
  "description": "Manage multiple OpenAI Codex profiles cleanly across VS Code windows.",
  "version": "0.0.1",
  "publisher": "andresvidal",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexProfiles.selectProfile",
        "title": "Codex Profiles: Select Profile"
      },
      {
        "command": "codexProfiles.createProfile",
        "title": "Codex Profiles: Create Profile"
      },
      {
        "command": "codexProfiles.showActiveProfile",
        "title": "Codex Profiles: Show Active Profile"
      },
      {
        "command": "codexProfiles.launchCodex",
        "title": "Codex Profiles: Launch Codex"
      }
    ],
    "configuration": {
      "title": "Codex Profiles",
      "properties": {
        "codexProfiles.profiles": {
          "type": "array",
          "default": [],
          "description": "Custom Codex profiles. The built-in Default profile is resolved from CODEX_HOME or the normal ~/.codex home and is not stored here. Authentication remains owned by Codex inside each CODEX_HOME.",
          "items": {
            "type": "object",
            "required": ["id", "name", "codexHome"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "codexHome": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "tsx --test test/**/*.test.ts",
    "ci": "npm run check && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.104.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
